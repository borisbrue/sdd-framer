{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "description": "Kanonische Datenstruktur eines Distribution-Tasks (CON-0096)",
  "type": "object",
  "required": [
    "id", "spec_id", "title", "description",
    "type", "complexity", "context_size", "estimated_tokens",
    "status", "retry_count", "llm_id", "container_id",
    "commit_hash", "dependencies", "error_context"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["code", "test", "config", "doc"]
    },
    "complexity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "context_size": {
      "type": "string",
      "enum": ["S", "M", "L"]
    },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending", "assigned", "running", "review",
        "passed", "failed", "committed", "retrying", "blocked"
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "llm_id": {
      "type": ["string", "null"]
    },
    "container_id": {
      "type": ["string", "null"]
    },
    "commit_hash": {
      "type": ["string", "null"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error_context": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 3
    },
    "con_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parallel_group": {
      "type": ["string", "null"]
    },
    "test_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actual_tokens": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "test_file": {
      "type": ["string", "null"]
    },
    "test_command": {
      "type": ["string", "null"]
    },
    "test_framework": {
      "type": ["string", "null"]
    }
  },
  "if": {
    "properties": { "status": { "const": "committed" } },
    "required": ["status"]
  },
  "then": {
    "properties": {
      "commit_hash": { "type": "string", "minLength": 1 }
    }
  }
}
