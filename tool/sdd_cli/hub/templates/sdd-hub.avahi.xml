<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">SDD Hub auf %h</name>
  <service>
    <type>_http._tcp</type>
    <port>{{ port }}</port>
    <txt-record>path=/hub/projects</txt-record>
  </service>
</service-group>
