{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer.local/schemas/arch-baseline.schema.json",
  "title": "SDD Architektur-Baseline (.sdd/quality/arch-baseline.json)",
  "description": "SPEC-0054 / CON-0198. Bekannte Architekturverstöße, die bis zu ihrer Behebung als warn gelten.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "file",
          "symbol",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^ARCH-[0-9]{2,}$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Symbol des Verstoßes gemäß Verstoß-Schlüssel (CON-0194 INV-09)."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "fixed_by": {
            "type": "string",
            "pattern": "^SPEC-[0-9]{4}$"
          }
        }
      }
    }
  }
}
