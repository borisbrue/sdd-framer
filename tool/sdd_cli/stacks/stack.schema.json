{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer.local/schemas/stack.schema.json",
  "title": "Stack-Vorlage und stack-Eintrag",
  "description": "SPEC-0057 / CON-0227. $defs/stack: stack.yaml einer Vorlage; $defs/entry: Eintrag der Liste stack: in config.yaml.",
  "$defs": {
    "stack": {
      "type": "object",
      "required": [
        "name",
        "version",
        "description",
        "languages"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tool",
              "version_command"
            ],
            "additionalProperties": false,
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "version_command": {
                "type": "string",
                "minLength": 1
              },
              "min": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)*$"
              },
              "install_hint": {
                "type": "string"
              },
              "optional": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "name",
        "version",
        "source",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "enum": [
            "project",
            "user",
            "blueprint"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
