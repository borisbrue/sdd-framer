{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer.local/schemas/bench-matrix.schema.json",
  "title": "Benchmark-Matrix und Suite",
  "description": "SPEC-0056 / CON-0221. bench/matrix.yaml und bench/suites/<name>.yaml.",
  "$defs": {
    "matrix": {
      "type": "object",
      "required": [
        "suites"
      ],
      "additionalProperties": false,
      "properties": {
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          }
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "roles"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "roles": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^([a-z_]+|\\*)$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+(@[A-Za-z0-9_-]+)?$"
                }
              }
            }
          }
        },
        "variants": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "sweep": {
          "type": "object",
          "required": [
            "role",
            "profiles"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            },
            "profiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+(@[A-Za-z0-9_-]+)?$"
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_claude_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "assignments"
          ]
        },
        {
          "required": [
            "sweep"
          ]
        },
        {
          "required": [
            "profiles"
          ]
        }
      ]
    },
    "suite": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "project": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "test_command": {
          "type": "string",
          "minLength": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "module",
              "tests"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "tests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "regen"
              }
            }
          },
          "then": {
            "required": [
              "commit",
              "test_command",
              "tasks"
            ]
          }
        }
      ]
    }
  }
}
