{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-blueprint.local/schemas/spec-frontmatter.schema.json",
  "title": "SDD Spec Frontmatter",
  "description": "Pflichtfelder im YAML-Frontmatter jeder Spec-Datei",
  "type": "object",
  "required": ["id", "title", "status", "owner", "created", "updated", "contracts", "tests"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{4,}$",
      "description": "Eindeutige Spec-ID, z.B. SPEC-0001"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "in-progress", "active", "implemented", "deprecated"]
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bug-fix"],
      "description": "Spec-Typ: 'feature' für neue Funktionalität, 'bug-fix' nur Symptombeschreibung (keine Root-Cause-Annahmen)"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "ISO-8601 Zeitstempel wann sdd start aufgerufen wurde (SPEC-0019)"
    },
    "owner": {
      "type": "string",
      "description": "Verantwortliche Person oder Team"
    },
    "created": {
      "description": "ISO-8601 Datum (YYYY-MM-DD). YAML parst dies als Date-Objekt – beides erlaubt."
    },
    "updated": {
      "description": "ISO-8601 Datum (YYYY-MM-DD). YAML parst dies als Date-Objekt – beides erlaubt."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "0.1.0"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SPEC-[0-9]{4,}$"
      },
      "description": "IDs anderer Specs, von denen diese abhängt"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CON-[0-9]{4,}$"
      },
      "description": "Mindestens eine zugehörige Contract-ID"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^TST-[0-9]{4,}[a-z]?$",
        "description": "Test-ID. Optionales Kleinbuchstaben-Suffix erlaubt (z.B. TST-0010b)"
      },
      "description": "Mindestens eine zugehörige Test-ID"
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4,}$"
      }
    }
  }
}
