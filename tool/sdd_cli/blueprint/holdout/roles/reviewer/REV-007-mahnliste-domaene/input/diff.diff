+"""Mahnliste für überfällige Mitgliedsbeiträge (SPEC-0014 FR-01, FR-02)."""
+from __future__ import annotations
+
+import sqlite3
+from dataclasses import dataclass
+from datetime import date, timedelta
+from decimal import Decimal
+
+from kasse.domain.ports import Clock
+
+KULANZ = timedelta(days=30)
+
+
+@dataclass(frozen=True)
+class Mahnposten:
+    mitglied_id: int
+    name: str
+    offen: Decimal
+    aeltestes_faellig: date
+
+
+def mahnliste(db_pfad: str, clock: Clock) -> list[Mahnposten]:
+    """Mitglieder mit Beiträgen, die länger als die Kulanzfrist offen sind, ältester zuerst."""
+    grenze = clock.today() - KULANZ
+    with sqlite3.connect(db_pfad) as con:
+        zeilen = con.execute(
+            "SELECT m.id, m.name, b.betrag, b.faellig FROM beitrag b "
+            "JOIN mitglied m ON m.id = b.mitglied_id WHERE b.bezahlt_am IS NULL"
+        ).fetchall()
+    posten: dict[int, Mahnposten] = {}
+    for mitglied_id, name, betrag, faellig_text in zeilen:
+        faellig = date.fromisoformat(faellig_text)
+        if faellig >= grenze:
+            continue
+        alt = posten.get(mitglied_id)
+        offen = Decimal(betrag) + (alt.offen if alt else Decimal("0"))
+        aeltestes = min(faellig, alt.aeltestes_faellig) if alt else faellig
+        posten[mitglied_id] = Mahnposten(mitglied_id, name, offen, aeltestes)
+    return sorted(posten.values(), key=lambda p: (p.aeltestes_faellig, p.mitglied_id))
