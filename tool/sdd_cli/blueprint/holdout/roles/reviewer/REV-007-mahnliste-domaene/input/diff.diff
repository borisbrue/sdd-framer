+import sqlite3
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+from kasse.domain.mahnung import mahnliste
+
+
+class FesteUhr:
+    def today(self):
+        return date(2026, 3, 31)
+
+
+class MahnlisteTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.db = str(Path(self.tmp.name) / "kasse.db")
+        with sqlite3.connect(self.db) as con:
+            con.executescript(Path("kasse/adapters/schema.sql").read_text())
+            con.executemany("INSERT INTO mitglied (id, name) VALUES (?, ?)",
+                            [(1, "Ada"), (2, "Bert")])
+            con.executemany(
+                "INSERT INTO beitrag (mitglied_id, betrag, faellig, bezahlt_am) VALUES (?,?,?,?)",
+                [(1, "24.00", "2026-01-15", None), (1, "24.00", "2026-02-15", None),
+                 (2, "24.00", "2026-03-15", None), (2, "24.00", "2026-01-01", "2026-01-03")])
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_fr01_fr02_ueberfaellige_summiert(self):
+        (posten,) = mahnliste(self.db, FesteUhr())
+        self.assertEqual(posten.mitglied_id, 1)
+        self.assertEqual(posten.offen, Decimal("48.00"))
+        self.assertEqual(posten.aeltestes_faellig, date(2026, 1, 15))
