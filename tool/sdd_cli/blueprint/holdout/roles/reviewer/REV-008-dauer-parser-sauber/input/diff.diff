 """Zeitangaben für den Pomodoro-Timer."""
 from __future__ import annotations
 
+import re
+
+_DAUER = re.compile(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?")
+MAX_SEKUNDEN = 24 * 3600
+
 
 def formatiere(sekunden: int) -> str:
     """Formatiert Sekunden als `MM:SS` bzw. `H:MM:SS` ab einer Stunde."""
@@ -9,3 +14,18 @@ def formatiere(sekunden: int) -> str:
     if stunden:
         return f"{stunden}:{minuten:02d}:{sek:02d}"
     return f"{minuten:02d}:{sek:02d}"
+
+
+def parse_dauer(text: str) -> int:
+    """Wandelt `1h30m`, `25m`, `90s` … in Sekunden um (FR-01, FR-02)."""
+    eingabe = text.strip()
+    treffer = _DAUER.fullmatch(eingabe)
+    if not eingabe or treffer is None:
+        raise ValueError(f"ungültige Dauer: {text!r} (erwartet z. B. 1h30m, 25m, 90s)")
+    h, m, s = (int(g) if g else 0 for g in treffer.groups())
+    gesamt = h * 3600 + m * 60 + s
+    if gesamt == 0:
+        raise ValueError("Dauer muss größer als 0 sein")
+    if gesamt > MAX_SEKUNDEN:
+        raise ValueError("Dauer darf höchstens 24h betragen")
+    return gesamt
