@@ -0,0 +1,25 @@
+import unittest
+
+from tempo.zeit import parse_dauer
+
+
+class ParseDauerTest(unittest.TestCase):
+    def test_fr01_einheiten_und_kombinationen(self):
+        self.assertEqual(parse_dauer("25m"), 1500)
+        self.assertEqual(parse_dauer("90s"), 90)
+        self.assertEqual(parse_dauer("1h30m"), 5400)
+        self.assertEqual(parse_dauer("1h0m5s"), 3605)
+        self.assertEqual(parse_dauer("90m"), 5400)
+        self.assertEqual(parse_dauer("  45m \n"), 2700)
+
+    def test_fr02_ungueltige_eingaben(self):
+        for text in ("", "   ", "30", "5x", "30m1h", "1h1h", "1.5h", "-5m", "1H", "1h 30m"):
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_dauer(text)
+
+    def test_fr02_grenzen(self):
+        with self.assertRaises(ValueError):
+            parse_dauer("0m")
+        self.assertEqual(parse_dauer("24h"), 86400)
+        with self.assertRaises(ValueError):
+            parse_dauer("24h1s")
