--- /dev/null
+++ b/tests/test_pagination.py
@@ -0,0 +1,28 @@
+import unittest
+
+from catalog.pagination import paginate
+
+
+class PaginateTest(unittest.TestCase):
+    def test_fr01_second_page(self):
+        page = paginate(list(range(25)), page=2, per_page=10)
+        self.assertEqual(page.items, list(range(10, 20)))
+        self.assertEqual(page.total, 25)
+
+    def test_fr02_rejects_invalid_arguments(self):
+        for page, per_page in ((0, 10), (1, 0), (1, 101)):
+            with self.assertRaises(ValueError):
+                paginate([1, 2, 3], page=page, per_page=per_page)
+
+    def test_fr03_total_pages_and_page_beyond_end(self):
+        self.assertEqual(paginate(list(range(25)), 1, 10).total_pages, 3)
+        self.assertEqual(paginate([], 1, 10).total_pages, 0)
+        self.assertEqual(paginate(list(range(25)), 4, 10).items, [])
+
+    def test_fr04_has_next(self):
+        self.assertTrue(paginate(list(range(25)), 2, 10).has_next)
+        self.assertFalse(paginate(list(range(25)), 3, 10).has_next)
+
+
+if __name__ == "__main__":
+    unittest.main()
