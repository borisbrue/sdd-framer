@@ -0,0 +1,34 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from attachments.errors import AttachmentNotFound
+from attachments.store import AttachmentStore
+
+
+class OpenAttachmentTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+        (self.root / "files").mkdir()
+        (self.root / "secret.txt").write_text("geheim")
+        self.store = AttachmentStore(self.root / "files")
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_fr03_returns_saved_content(self):
+        name = self.store.save(b"hallo", ".txt")
+        self.assertEqual(self.store.open_attachment(name), b"hallo")
+
+    def test_fr03_missing_file(self):
+        with self.assertRaises(AttachmentNotFound):
+            self.store.open_attachment("gibt-es-nicht.txt")
+
+    def test_fr03_parent_directory_is_rejected(self):
+        with self.assertRaises(AttachmentNotFound):
+            self.store.open_attachment("../secret.txt")
+
+
+if __name__ == "__main__":
+    unittest.main()
