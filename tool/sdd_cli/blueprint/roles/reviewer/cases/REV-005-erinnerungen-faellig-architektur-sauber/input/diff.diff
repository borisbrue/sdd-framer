--- /dev/null
+++ b/reminders/domain/due.py
@@ -0,0 +1,13 @@
+"""Fällige Erinnerungen (SPEC-0031 FR-02)."""
+
+from collections.abc import Iterable
+
+from reminders.domain.clock import Clock
+from reminders.domain.model import Reminder
+
+
+def due_reminders(reminders: Iterable[Reminder], clock: Clock) -> list[Reminder]:
+    """Offene Erinnerungen mit ``due_at <= jetzt``, älteste zuerst."""
+    now = clock.now()
+    return sorted((r for r in reminders if not r.done and r.due_at <= now),
+                  key=lambda r: r.due_at)
diff --git a/tests/test_due.py b/tests/test_due.py
new file mode 100644
index 0000000..a0083c7
--- /dev/null
+++ b/tests/test_due.py
@@ -0,0 +1,47 @@
+import io
+import json
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from datetime import datetime, timezone
+from pathlib import Path
+
+from reminders.cli import main
+from reminders.domain.due import due_reminders
+from reminders.domain.model import Reminder
+
+NOW = datetime(2026, 3, 1, 12, 0, tzinfo=timezone.utc)
+
+
+class FixedClock:
+    def now(self):
+        return NOW
+
+
+def at(hour, minute=0):
+    return datetime(2026, 3, 1, hour, minute, tzinfo=timezone.utc)
+
+
+class DueRemindersTest(unittest.TestCase):
+    def test_fr02_open_due_sorted_inclusive(self):
+        items = [Reminder("a", "später", at(13)), Reminder("b", "genau jetzt", at(12)),
+                 Reminder("c", "erledigt", at(9), done=True), Reminder("d", "früh", at(8))]
+        self.assertEqual([r.id for r in due_reminders(items, FixedClock())], ["d", "b"])
+
+    def test_fr03_cli_prints_due_lines(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "r.json"
+            path.write_text(json.dumps([
+                {"id": "x", "text": "Zahnarzt", "due_at": "2020-05-04T09:30:00+00:00",
+                 "done": False},
+                {"id": "y", "text": "Zukunft", "due_at": "2999-01-01T00:00:00+00:00",
+                 "done": False}]))
+            out = io.StringIO()
+            with redirect_stdout(out):
+                code = main(["--file", str(path), "due"])
+        self.assertEqual(code, 0)
+        self.assertEqual(out.getvalue(), "2020-05-04 09:30  Zahnarzt\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
