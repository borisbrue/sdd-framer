@@ -0,0 +1,25 @@
+import unittest
+
+from userimport.importer import import_rows
+
+HEADER = "email,name,role\n"
+
+
+class ImportRowsTest(unittest.TestCase):
+    def test_fr02_normalizes_and_skips_duplicates(self):
+        report = import_rows([HEADER, " Ada@Example.org ,Ada,admin\n", "ada@example.org,Ada L.,editor\n"])
+        self.assertEqual([u.email for u in report.imported], ["ada@example.org"])
+        self.assertEqual(report.skipped_duplicates, 1)
+
+    def test_fr03_invalid_email_reported_with_line(self):
+        report = import_rows([HEADER, "kein-at,Bob,viewer\n", ",Eve,viewer\n"])
+        self.assertEqual(report.imported, [])
+        self.assertEqual([e.line for e in report.errors], [2, 3])
+
+    def test_fr04_default_role(self):
+        report = import_rows([HEADER, "c@example.org,Carl,\n"])
+        self.assertEqual(report.imported[0].role, "viewer")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/userimport/importer.py b/userimport/importer.py
