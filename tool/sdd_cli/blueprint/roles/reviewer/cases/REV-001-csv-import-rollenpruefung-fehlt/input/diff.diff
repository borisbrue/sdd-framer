--- /dev/null
+++ b/userimport/importer.py
@@ -0,0 +1,29 @@
+"""Import von Benutzern aus CSV-Zeilen (SPEC-0007 FR-02..FR-04)."""
+
+import csv
+from collections.abc import Iterable
+
+from userimport.models import DEFAULT_ROLE, ImportReport, RowError, User
+
+
+def _normalize_email(raw: str) -> str:
+    return raw.strip().lower()
+
+
+def import_rows(lines: Iterable[str]) -> ImportReport:
+    """Liest CSV mit Kopfzeile ``email,name,role`` und baut den Importbericht."""
+    report = ImportReport()
+    seen: set[str] = set()
+    reader = csv.DictReader(lines)
+    for line_no, row in enumerate(reader, start=2):
+        email = _normalize_email(row.get("email") or "")
+        if not email or "@" not in email:
+            report.errors.append(RowError(line_no, "ungültige E-Mail"))
+            continue
+        if email in seen:
+            report.skipped_duplicates += 1
+            continue
+        role = (row.get("role") or "").strip().lower() or DEFAULT_ROLE
+        seen.add(email)
+        report.imported.append(User(email, (row.get("name") or "").strip(), role))
+    return report
