{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer/contracts/data/hotfix-record-schema.schema.json",
  "title": "Hotfix Record (CON-0119)",
  "description": "Frontmatter eines Hotfix-Records unter .sdd/hotfixes/HF-XXXX.md (SPEC-0031).",
  "type": "object",
  "required": ["id", "description", "status", "created", "commit"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^HF-[0-9]{4}$"},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "done", "aborted"]},
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
    },
    "commit": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "open"}}, "required": ["status"]},
      "then": {"properties": {"commit": {"const": ""}}}
    },
    {
      "if": {"properties": {"status": {"const": "done"}}, "required": ["status"]},
      "then": {"properties": {"commit": {"pattern": "^[0-9a-f]{40}$"}}}
    }
  ]
}
