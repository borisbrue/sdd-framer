{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer.local/schemas/quality-report.schema.json",
  "title": "SDD Quality-Report",
  "description": "SPEC-0054 / CON-0195. Ausgabe von `sdd quality measure --json`. Der Score-Baum ist die Serialisierung des Composite aus SPEC-0054 §3.",
  "type": "object",
  "required": ["schema_version", "git_sha", "generated_at", "duration_ms", "incomplete", "score", "tree", "requirements", "architecture", "probes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "spec": { "type": "string", "pattern": "^SPEC-[0-9]{4}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "base_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "incomplete": {
      "type": "boolean",
      "description": "true, sobald irgendein Knoten des Baums n/a ist und renormiert wurde."
    },
    "score": { "$ref": "#/$defs/score" },
    "tree": { "$ref": "#/$defs/node" },
    "requirements": {
      "type": "object",
      "required": ["frs"],
      "additionalProperties": false,
      "properties": {
        "frs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "tests"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^FR-[0-9]+[a-z]?$" },
              "status": { "enum": ["erfüllt", "teilweise", "fehlt", "unbekannt"] },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "status", "source"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "status": { "enum": ["passed", "failed", "error", "skipped", "not_run"] },
                    "source": { "enum": ["fr_test_map", "task_fr_ids", "junit_property", "junit_name"] }
                  }
                }
              }
            }
          }
        },
        "holdout_pass_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "test_run": { "type": "string", "description": "Pfad des genutzten Test-Run-Reports (SPEC-0006)." }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["violations", "rules_na", "unresolved_edges"],
      "additionalProperties": false,
      "properties": {
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "adr", "file", "line", "severity", "baselined"],
            "additionalProperties": false,
            "properties": {
              "rule": { "type": "string", "pattern": "^ARCH-[0-9]{2,}$" },
              "adr": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
              "adr_title": { "type": "string" },
              "file": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "symbol": { "type": "string" },
              "excerpt": { "type": "string" },
              "severity": { "enum": ["error", "warn"] },
              "baselined": { "type": "boolean" }
            }
          }
        },
        "rules_na": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "reason"],
            "additionalProperties": false,
            "properties": {
              "rule": { "type": "string", "pattern": "^ARCH-[0-9]{2,}$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unresolved_edges": { "type": "integer", "minimum": 0 },
        "stale_baseline_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "format", "status", "duration_ms"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "format": { "type": "string" },
          "status": { "enum": ["ok", "n/a"] },
          "reason": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "tool_version": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        },
        "if": { "properties": { "status": { "const": "n/a" } } },
        "then": { "required": ["reason"] }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression", "passed"],
        "additionalProperties": false,
        "properties": {
          "expression": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "excluded_findings": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "score": {
      "description": "Wert in [0,1] oder null für n/a.",
      "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
    },
    "metric": {
      "type": "object",
      "required": ["name", "raw", "normalized"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "raw": { "type": ["number", "null"] },
        "normalized": { "$ref": "#/$defs/score" },
        "good": { "type": "number" },
        "bad": { "type": "number" },
        "weight": { "type": "number", "minimum": 0 },
        "source_probe": { "type": "string" },
        "reason": { "type": "string" }
      },
      "if": { "properties": { "normalized": { "type": "null" } } },
      "then": { "required": ["reason"] }
    },
    "node": {
      "type": "object",
      "required": ["name", "weight", "score"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0 },
        "score": { "$ref": "#/$defs/score" },
        "renormalized": { "type": "boolean", "default": false },
        "reason": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "model": { "type": "string", "description": "Nur Knoten judge: bewertendes Modell." },
        "rubric_version": { "type": "string", "description": "Nur Knoten judge." }
      }
    }
  }
}
