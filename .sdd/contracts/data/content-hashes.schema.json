  "title": "SDD Content-Hashes",
  "description": "Mapping von Artefakt-ID zu SHA-256-Hash des bereinigten Inhalts (SPEC-0010 CON-0038)",
  "type": "object",
  "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
  },
  "examples": [
