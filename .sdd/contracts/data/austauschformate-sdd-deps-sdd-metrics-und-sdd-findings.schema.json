{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer.local/schemas/sdd-exchange-formats.schema.json",
  "title": "SDD Austauschformate: sdd-deps, sdd-metrics, sdd-findings",
  "description": "SPEC-0054 / CON-0193. Ausgabeformate für Sonden, für die es keinen verbreiteten Standard gibt. Jede Datei nennt ihr Format im Feld 'format'.",
  "oneOf": [
    {
      "$ref": "#/$defs/deps"
    },
    {
      "$ref": "#/$defs/metrics"
    },
    {
      "$ref": "#/$defs/findings"
    }
  ],
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$",
      "description": "Pfad relativ zur Projektwurzel, Trennzeichen '/', ohne '..'."
    },
    "tool": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "deps": {
      "type": "object",
      "required": [
        "format",
        "version",
        "kinds_provided",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "sdd-deps"
        },
        "version": {
          "const": 1
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "kinds_provided": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "import",
              "call",
              "write"
            ]
          },
          "description": "Kantenarten, die der Extraktor vollständig liefert. Fehlt eine Art, sind Regeln, die sie brauchen, n/a."
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "kind",
              "symbol",
              "file",
              "line"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "$ref": "#/$defs/relpath"
              },
              "to": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/relpath"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "import: importierte Datei; write: geschriebener Pfad; call: Datei der aufgerufenen Definition, falls auflösbar. null, wenn nicht auflösbar."
              },
              "kind": {
                "enum": [
                  "import",
                  "call",
                  "write"
                ]
              },
              "symbol": {
                "type": "string",
                "minLength": 1,
                "description": "import: importierter Name (Modul oder Symbol); call: voll qualifizierter Aufrufname (z. B. subprocess.run); write: schreibende Funktion (z. B. pathlib.Path.write_text)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Nur bei call: statisch auflösbare Literal-Argumente."
              },
              "file": {
                "$ref": "#/$defs/relpath"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "unresolved": {
                "type": "boolean",
                "default": false
              }
            },
            "allOf": [
              {
                "if": {
                  "not": {
                    "properties": {
                      "kind": {
                        "const": "call"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "to": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unresolved": {
                      "const": true
                    }
                  },
                  "required": [
                    "unresolved"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "format",
        "version",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "sdd-metrics"
        },
        "version": {
          "const": 1
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "value": {
                "type": "number"
              },
              "scope": {
                "description": "'project' (Default) oder ein Dateipfad.",
                "anyOf": [
                  {
                    "const": "project"
                  },
                  {
                    "$ref": "#/$defs/relpath"
                  }
                ]
              },
              "unit": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "required": [
        "format",
        "version",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "sdd-findings"
        },
        "version": {
          "const": 1
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "message",
              "file",
              "line",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "$ref": "#/$defs/relpath"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "note"
                ]
              }
            }
          }
        }
      }
    }
  }
}
