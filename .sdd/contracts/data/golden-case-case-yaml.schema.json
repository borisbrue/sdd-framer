{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-framer.local/schemas/role-case.schema.json",
  "title": "Golden Case einer Rolle (case.yaml)",
  "description": "SPEC-0055 / CON-0217. Ort bestimmt Holdout: .sdd/roles/<rolle>/cases/<ID>/ sichtbar, .sdd/holdout/roles/<rolle>/<ID>/ Holdout.",
  "type": "object",
  "required": [
    "id",
    "role",
    "origin",
    "expect"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(DEC|TAU|IMP|REV|SUP|JDG)-[0-9]{3,}$"
    },
    "role": {
      "enum": [
        "decomposer",
        "test_author",
        "implementer",
        "reviewer",
        "supervisor",
        "judge"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "pattern": "^(blueprint|manual|captured:.+)$"
    },
    "draft": {
      "type": "boolean",
      "default": false
    },
    "test_command": {
      "type": "string",
      "minLength": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "default": 120
    },
    "expect": {
      "type": "object",
      "required": [
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rubric": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
