{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-blueprint.local/schemas/conflict-report.schema.json",
  "title": "SDD Conflict Report",
  "description": "Schema für .sdd/conflict-reports/{spec-id}-conflicts.json (CON-0029)",
  "type": "object",
  "required": ["spec_id", "generated_at", "new_contracts", "conflicts", "impact_summary"],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{4,}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "new_contracts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CON-[0-9]{4,}$" }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "severity", "new_contract", "conflicting_contract", "detail", "affected_specs", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CF-[0-9]+-[0-9]{3,}$",
            "description": "CF-{SPEC_NUM}-{NNN}, z.B. CF-0014-001"
          },
          "type": {
            "type": "string",
            "enum": ["endpoint-overlap", "field-contradiction", "behavior-contradiction", "scope-overlap", "dependency-gap"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "new_contract": {
            "type": "string",
            "pattern": "^CON-[0-9]{4,}$"
          },
          "conflicting_contract": {
            "type": "string",
            "pattern": "^CON-[0-9]{4,}$"
          },
          "detail": {
            "type": "string",
            "minLength": 10
          },
          "affected_specs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^SPEC-[0-9]{4,}$" }
          },
          "required_action": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "acknowledged"]
          },
          "resolution": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["action", "resolved_at"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["refactor", "extend", "version", "split", "acknowledged"]
                  },
                  "reason": { "type": "string" },
                  "resolved_at": { "type": "string", "format": "date-time" }
                }
              }
            ]
          }
        }
      }
    },
    "impact_summary": {
      "type": "object",
      "required": ["total_conflicts", "high", "medium", "low", "affected_specs_count"],
      "properties": {
        "total_conflicts": { "type": "integer", "minimum": 0 },
        "high":            { "type": "integer", "minimum": 0 },
        "medium":          { "type": "integer", "minimum": 0 },
        "low":             { "type": "integer", "minimum": 0 },
        "affected_specs_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
